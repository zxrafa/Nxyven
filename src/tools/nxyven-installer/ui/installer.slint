// SPDX-License-Identifier: AGPL-3.0-or-later
// NXYVEN Installer Interface — Sleek Minimalist Dark & Radiant Orange

component NxMark inherits Rectangle {
    in property <length> size: 28px;
    width: root.size;
    height: root.size;
    border-radius: root.size * 0.22;
    background: @linear-gradient(135deg, #FF4D00 0%, #FF6A24 50%, #FF9A62 100%);

    Path {
        width: 100%;
        height: 100%;
        commands: "M 4.5 15.5 L 4.5 4.5 L 7.5 4.5 L 10.5 11 L 10.5 4.5 L 12.5 4.5 L 12.5 15.5 L 9.5 15.5 L 6.5 9 L 6.5 15.5 Z M 13.5 4.5 L 15.5 8 L 17.5 4.5 L 19.5 4.5 L 16.5 9.8 L 19.5 15.5 L 17.5 15.5 L 15.5 11.5 L 13.5 15.5 L 11.5 15.5 L 14.5 9.8 L 11.5 4.5 Z";
        viewbox-x: 3;
        viewbox-y: 3;
        viewbox-width: 18;
        viewbox-height: 18;
        fill: #ffffff;
    }
}

component WindowControlBtn inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;
    callback clicked();

    width: 38px;
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover ? (root.danger ? #e11d4833 : #ffffff14) : Colors.transparent;
    animate background { duration: 120ms; }

    Text {
        text: root.text;
        font-size: 13px;
        color: touch.has-hover ? (root.danger ? #fb7185 : #ffffff) : #8e8e9c;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ModernCheckbox inherits Rectangle {
    in-out property <bool> checked: true;
    in property <string> label;

    height: 28px;
    background: Colors.transparent;

    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        box := Rectangle {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: root.checked ? @linear-gradient(135deg, #FF4D00 0%, #FF6A24 100%) : #181820;
            border-width: 1px;
            border-color: root.checked ? #FF9A62 : (touch.has-hover ? #525266 : #2e2e3c);

            animate background, border-color { duration: 140ms; }

            if root.checked: Path {
                width: 100%;
                height: 100%;
                commands: "M 4 9 L 7.5 12.5 L 14 5.5";
                stroke: #ffffff;
                stroke-width: 2.2px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 18;
                viewbox-height: 18;
            }
        }

        Text {
            text: root.label;
            font-size: 13px;
            color: touch.has-hover ? #f4f4f6 : #a5a5b6;
            vertical-alignment: center;
            animate color { duration: 120ms; }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }
    }
}

export component InstallerWindow inherits Window {
    title: "Instalador Oficial NXYVEN";
    width: 500px;
    height: 520px;
    background: Colors.transparent;
    no-frame: true;

    in-out property <int> step: 0; // 0 = Setup, 1 = Installing, 2 = Completed
    in-out property <string> install-path: "C:\\Users\\MANCER\\AppData\\Local\\Programs\\NXYVEN";
    in-out property <bool> create-desktop-shortcut: true;
    in-out property <bool> create-start-menu-shortcut: true;
    in-out property <float> progress: 0.0;
    in-out property <string> status-text: "Pronto para iniciar a instalação.";

    callback start-install();
    callback launch-app();
    callback close-window();
    callback minimize-window();
    callback choose-folder();
    callback begin-drag();

    // Main Card Frame with Rounded Corners
    main-card := Rectangle {
        width: parent.width;
        height: parent.height;
        background: #0D0D12;
        border-radius: 16px;
        border-width: 1px;
        border-color: #262634;
        clip: true;

        // Subtle orange ambient glow in top corner
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 180px;
            background: @linear-gradient(180deg, #FF4D0018 0%, #0D0D1200 100%);
        }

        VerticalLayout {
            // Header Bar
            Rectangle {
                height: 48px;

                TouchArea {
                    width: parent.width - 95px;
                    height: parent.height;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.begin-drag();
                        }
                    }
                }

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: 20px;
                    padding-right: 12px;
                    padding-top: 8px;
                    spacing: 12px;
                padding-left: 20px;
                padding-right: 12px;
                padding-top: 8px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    y: (parent.height - self.height) / 2;

                    NxMark { size: 24px; }

                    Text {
                        text: "NXYVEN";
                        font-size: 15px;
                        font-weight: 800;
                        color: #ffffff;
                        letter-spacing: 1.8px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 1px;
                        height: 14px;
                        background: #2b2b3a;
                        y: (parent.height - self.height) / 2;
                    }

                    Rectangle {
                        height: 20px;
                        border-radius: 4px;
                        background: #FF4D001f;
                        border-width: 1px;
                        border-color: #FF6A2444;
                        y: (parent.height - self.height) / 2;

                        Text {
                            x: 8px;
                            y: (parent.height - self.height) / 2;
                            text: "v1.0.0 FINAL";
                            font-size: 10px;
                            font-weight: 700;
                            color: #FF9A62;
                            letter-spacing: 0.8px;
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                HorizontalLayout {
                    spacing: 4px;
                    alignment: end;
                    WindowControlBtn {
                        text: "—";
                        clicked => { root.minimize-window(); }
                    }
                    WindowControlBtn {
                        text: "✕";
                        danger: true;
                        clicked => { root.close-window(); }
                    }
                }
            }
        }

        // Divider Line
            Rectangle {
                height: 1px;
                background: #1e1e2a;
            }

            // Body Container
            Rectangle {
                vertical-stretch: 1;

                // ── STEP 0: Configuration Page ───────────────────────────
                if root.step == 0: VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    spacing: 20px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: "Bem-vindo ao NXYVEN Video Editor";
                            font-size: 22px;
                            font-weight: 700;
                            color: #f6f6f8;
                            letter-spacing: -0.3px;
                        }

                        Text {
                            text: "Editor de vídeo comercial desktop com aceleração por GPU, inteligência de áudio e 127 shaders.";
                            font-size: 13px;
                            color: #8a8a9a;
                        }
                    }

                    // Path Selector
                    VerticalLayout {
                        spacing: 8px;

                        Text {
                            text: "LOCAL DE INSTALAÇÃO";
                            font-size: 11px;
                            font-weight: 700;
                            color: #9c9cb0;
                            letter-spacing: 0.8px;
                        }

                        HorizontalLayout {
                            height: 42px;
                            spacing: 10px;

                            path-box := Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 8px;
                                background: #13131a;
                                border-width: 1px;
                                border-color: path-input.has-focus ? #FF6A24 : #282838;
                                animate border-color { duration: 140ms; }

                                path-input := TextInput {
                                    x: 14px;
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width - 28px;
                                    text <=> root.install-path;
                                    color: #f0f0f4;
                                    font-size: 13px;
                                    single-line: true;
                                }
                            }

                            reset-btn := Rectangle {
                                width: 95px;
                                border-radius: 8px;
                                background: reset-touch.has-hover ? #252534 : #1a1a24;
                                border-width: 1px;
                                border-color: #323244;
                                animate background { duration: 120ms; }

                                Text {
                                    text: "Padrão";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #e4e4ec;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                reset-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.choose-folder(); }
                                }
                            }
                        }
                    }

                    // Shortcut Checkboxes
                    VerticalLayout {
                        spacing: 12px;

                        ModernCheckbox {
                            label: "Criar atalho na Área de Trabalho (Desktop)";
                            checked <=> root.create-desktop-shortcut;
                        }

                        ModernCheckbox {
                            label: "Adicionar atalho ao Menu Iniciar do Windows";
                            checked <=> root.create-start-menu-shortcut;
                        }
                    }

                    // Action Buttons
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: end;

                        cancel-btn := Rectangle {
                            width: 115px;
                            height: 40px;
                            border-radius: 8px;
                            background: cancel-touch.has-hover ? #1f1f2c : Colors.transparent;
                            border-width: 1px;
                            border-color: #2c2c3c;

                            Text {
                                text: "Cancelar";
                                font-size: 13px;
                                font-weight: 600;
                                color: #9c9cb0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            cancel-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close-window(); }
                            }
                        }

                        install-btn := Rectangle {
                            width: 175px;
                            height: 40px;
                            border-radius: 8px;
                            background: install-touch.has-hover
                                ? @linear-gradient(135deg, #FF5E1A 0%, #FF7B3D 50%, #FFA875 100%)
                                : @linear-gradient(135deg, #FF4D00 0%, #FF6A24 50%, #FF9A62 100%);
                            animate background { duration: 140ms; }

                            Text {
                                text: "Instalar NXYVEN";
                                font-size: 13px;
                                font-weight: 700;
                                color: #ffffff;
                                letter-spacing: 0.5px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            install-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.start-install(); }
                            }
                        }
                    }
                }

                // ── STEP 1: Progress Page ────────────────────────────────
                if root.step == 1: VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    spacing: 26px;
                    alignment: center;

                    VerticalLayout {
                        spacing: 12px;
                        alignment: center;

                        NxMark {
                            size: 60px;
                            x: (parent.width - self.width) / 2;
                        }

                        Text {
                            text: "Instalando NXYVEN…";
                            font-size: 22px;
                            font-weight: 700;
                            color: #f6f6f8;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.status-text;
                            font-size: 13px;
                            color: #9c9cb0;
                            horizontal-alignment: center;
                        }
                    }

                    // Progress Bar
                    VerticalLayout {
                        spacing: 8px;
                        width: parent.width * 0.88;
                        x: (parent.width - self.width) / 2;

                        Rectangle {
                            height: 8px;
                            border-radius: 4px;
                            background: #181822;
                            border-width: 1px;
                            border-color: #2c2c3e;
                            clip: true;

                            Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width * Math.min(1.0, Math.max(0.02, root.progress));
                                height: parent.height;
                                border-radius: 4px;
                                background: @linear-gradient(90deg, #FF4D00 0%, #FF6A24 70%, #FF9A62 100%);
                                animate width { duration: 150ms; easing: ease-out; }
                            }
                        }

                        HorizontalLayout {
                            Text {
                                text: "Extraindo arquivos, registrando codecs e atalhos...";
                                font-size: 11px;
                                color: #6a6a7c;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: Math.round(root.progress * 100) + "%";
                                font-size: 12px;
                                font-weight: 700;
                                color: #FF9A62;
                            }
                        }
                    }
                }

                // ── STEP 2: Completed Page ───────────────────────────────
                if root.step == 2: VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    spacing: 26px;
                    alignment: center;

                    // Radiant Success Checkmark
                    Rectangle {
                        width: 68px;
                        height: 68px;
                        x: (parent.width - self.width) / 2;
                        border-radius: 34px;
                        background: @linear-gradient(135deg, #FF4D0022 0%, #FF6A2444 100%);
                        border-width: 2px;
                        border-color: #FF6A24;

                        Path {
                            width: 100%;
                            height: 100%;
                            commands: "M 6 12 L 10 16 L 18 8";
                            stroke: #FF9A62;
                            stroke-width: 3.2px;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 24;
                            viewbox-height: 24;
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "Instalação Concluída!";
                            font-size: 24px;
                            font-weight: 700;
                            color: #f6f6f8;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "O NXYVEN Pro v1.0.0 está instalado e pronto para uso.";
                            font-size: 13px;
                            color: #9292a4;
                            horizontal-alignment: center;
                        }
                    }

                    // Completion Actions
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: center;

                        finish-btn := Rectangle {
                            width: 125px;
                            height: 42px;
                            border-radius: 8px;
                            background: finish-touch.has-hover ? #222230 : #191924;
                            border-width: 1px;
                            border-color: #323246;

                            Text {
                                text: "Fechar";
                                font-size: 13px;
                                font-weight: 600;
                                color: #d0d0dc;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            finish-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close-window(); }
                            }
                        }

                        launch-btn := Rectangle {
                            width: 180px;
                            height: 42px;
                            border-radius: 8px;
                            background: launch-touch.has-hover
                                ? @linear-gradient(135deg, #FF5E1A 0%, #FF7B3D 50%, #FFA875 100%)
                                : @linear-gradient(135deg, #FF4D00 0%, #FF6A24 50%, #FF9A62 100%);
                            animate background { duration: 140ms; }

                            Text {
                                text: "Iniciar NXYVEN";
                                font-size: 13px;
                                font-weight: 700;
                                color: #ffffff;
                                letter-spacing: 0.5px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            launch-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.launch-app(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
