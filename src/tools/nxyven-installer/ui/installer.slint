// NXYVEN Installer Interface — Ultra-Modern Dark & Radiant Orange

export component NxMark inherits Rectangle {
    in property <length> size: 28px;
    width: root.size;
    height: root.size;
    border-radius: root.size * 0.22;
    background: @linear-gradient(135deg, #FF4D00 0%, #FF6A24 50%, #FF9A62 100%);

    Path {
        width: 100%;
        height: 100%;
        commands: "M 4.5 15.5 L 4.5 4.5 L 7.5 4.5 L 10.5 11 L 10.5 4.5 L 12.5 4.5 L 12.5 15.5 L 9.5 15.5 L 6.5 9 L 6.5 15.5 Z M 13.5 4.5 L 15.5 8 L 17.5 4.5 L 19.5 4.5 L 16.5 9.8 L 19.5 15.5 L 17.5 15.5 L 15.5 11.5 L 13.5 15.5 L 11.5 15.5 L 14.5 9.8 L 11.5 4.5 Z";
        viewbox-x: 3;
        viewbox-y: 3;
        viewbox-width: 18;
        viewbox-height: 18;
        fill: #ffffff;
    }
}

component IconButton inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;
    callback clicked();

    width: 36px;
    height: 30px;
    border-radius: 4px;
    background: touch.has-hover ? (root.danger ? #e11d4833 : #ffffff12) : Colors.transparent;
    animate background { duration: 120ms; }

    Text {
        text: root.text;
        font-size: 13px;
        color: touch.has-hover ? (root.danger ? #fb7185 : #ffffff) : #8e8e9a;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ModernCheckbox inherits Rectangle {
    in-out property <bool> checked: true;
    in property <string> label;

    height: 24px;
    background: Colors.transparent;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;

        box := Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.checked ? @linear-gradient(135deg, #FF4D00 0%, #FF6A24 100%) : #1c1c24;
            border-width: 1px;
            border-color: root.checked ? #FF9A62 : (touch.has-hover ? #4a4a58 : #2e2e3a);

            animate background, border-color { duration: 140ms; }

            if root.checked: Path {
                width: 100%;
                height: 100%;
                commands: "M 4 9 L 7.5 12.5 L 14 5.5";
                stroke: #ffffff;
                stroke-width: 2px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 18;
                viewbox-height: 18;
            }
        }

        Text {
            text: root.label;
            font-size: 13px;
            color: touch.has-hover ? #f4f4f6 : #a5a5b2;
            vertical-alignment: center;
            animate color { duration: 120ms; }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }
    }
}

export component InstallerWindow inherits Window {
    title: "Instalador NXYVEN";
    width: 620px;
    height: 440px;
    background: #0B0B0E;
    no-frame: true;

    in-out property <int> step: 0; // 0 = Setup, 1 = Installing, 2 = Completed
    in-out property <string> install-path: "C:\\Program Files\\NXYVEN";
    in-out property <bool> create-desktop-shortcut: true;
    in-out property <bool> create-start-menu-shortcut: true;
    in-out property <float> progress: 0.0;
    in-out property <string> status-text: "Pronto para instalar.";
    in-out property <string> error-text: "";

    callback start-install();
    callback launch-app();
    callback close-window();
    callback minimize-window();
    callback choose-folder();

    // Subtle background mesh gradient
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 140px;
        background: @linear-gradient(180deg, #FF4D0014 0%, #0B0B0E00 100%);
    }

    // Outer border
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        border-width: 1px;
        border-color: #24242e;
        border-radius: 10px;
        clip: true;

        VerticalLayout {
            // Header / Title bar
            HorizontalLayout {
                height: 44px;
                padding-left: 18px;
                padding-right: 8px;
                padding-top: 6px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    y: (parent.height - self.height) / 2;

                    NxMark { size: 22px; }

                    Text {
                        text: "NXYVEN";
                        font-size: 14px;
                        font-weight: 700;
                        color: #ffffff;
                        letter-spacing: 1.5px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 1px;
                        height: 14px;
                        background: #2a2a36;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "INSTALADOR OFICIAL";
                        font-size: 10px;
                        font-weight: 600;
                        color: #FF9A62;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                HorizontalLayout {
                    spacing: 2px;
                    alignment: end;
                    IconButton {
                        text: "—";
                        clicked => { root.minimize-window(); }
                    }
                    IconButton {
                        text: "✕";
                        danger: true;
                        clicked => { root.close-window(); }
                    }
                }
            }

            // Divider
            Rectangle {
                height: 1px;
                background: #1d1d26;
            }

            // Main Content Area
            Rectangle {
                vertical-stretch: 1;
                padding: 24px;

                // ── STEP 0: Configuration ────────────────────────────────
                if root.step == 0: VerticalLayout {
                    spacing: 20px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 8px;

                        Text {
                            text: "Instalação do NXYVEN Pro";
                            font-size: 22px;
                            font-weight: 700;
                            color: #f6f6f8;
                        }

                        Text {
                            text: "Editor de vídeo desktop profissional, com aceleração por GPU e engine nativa.";
                            font-size: 13px;
                            color: #8c8c9a;
                        }
                    }

                    // Directory Selection Box
                    VerticalLayout {
                        spacing: 8px;

                        Text {
                            text: "PASTA DE INSTALAÇÃO";
                            font-size: 11px;
                            font-weight: 600;
                            color: #a4a4b2;
                            letter-spacing: 0.8px;
                        }

                        HorizontalLayout {
                            height: 40px;
                            spacing: 10px;

                            path-box := Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 6px;
                                background: #121217;
                                border-width: 1px;
                                border-color: path-input.has-focus ? #FF6A24 : #282834;
                                animate border-color { duration: 140ms; }

                                path-input := TextInput {
                                    x: 12px;
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width - 24px;
                                    text <=> root.install-path;
                                    color: #ececf0;
                                    font-size: 13px;
                                    single-line: true;
                                }
                            }

                            browse-btn := Rectangle {
                                width: 90px;
                                border-radius: 6px;
                                background: browse-touch.has-hover ? #252530 : #1a1a22;
                                border-width: 1px;
                                border-color: #30303e;
                                animate background { duration: 120ms; }

                                Text {
                                    text: "Padrão";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #e2e2e8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                browse-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.choose-folder(); }
                                }
                            }
                        }
                    }

                    // Options Checkboxes
                    VerticalLayout {
                        spacing: 10px;

                        ModernCheckbox {
                            label: "Criar atalho na Área de Trabalho (Desktop)";
                            checked <=> root.create-desktop-shortcut;
                        }

                        ModernCheckbox {
                            label: "Adicionar ao Menu Iniciar do Windows";
                            checked <=> root.create-start-menu-shortcut;
                        }
                    }

                    // Footer Buttons
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: end;

                        cancel-btn := Rectangle {
                            width: 110px;
                            height: 38px;
                            border-radius: 6px;
                            background: cancel-touch.has-hover ? #1f1f28 : Colors.transparent;
                            border-width: 1px;
                            border-color: #2e2e3a;

                            Text {
                                text: "Cancelar";
                                font-size: 13px;
                                font-weight: 500;
                                color: #a0a0b0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            cancel-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close-window(); }
                            }
                        }

                        install-btn := Rectangle {
                            width: 160px;
                            height: 38px;
                            border-radius: 6px;
                            background: install-touch.has-hover
                                ? @linear-gradient(135deg, #FF5E1A 0%, #FF7B3D 50%, #FFA875 100%)
                                : @linear-gradient(135deg, #FF4D00 0%, #FF6A24 50%, #FF9A62 100%);
                            animate background { duration: 140ms; }

                            Text {
                                text: "Instalar NXYVEN";
                                font-size: 13px;
                                font-weight: 700;
                                color: #ffffff;
                                letter-spacing: 0.5px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            install-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.start-install(); }
                            }
                        }
                    }
                }

                // ── STEP 1: Installing Progress ──────────────────────────
                if root.step == 1: VerticalLayout {
                    spacing: 24px;
                    alignment: center;

                    VerticalLayout {
                        spacing: 10px;
                        alignment: center;

                        NxMark {
                            size: 56px;
                            x: (parent.width - self.width) / 2;
                        }

                        Text {
                            text: "Instalando NXYVEN…";
                            font-size: 20px;
                            font-weight: 700;
                            color: #f6f6f8;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.status-text;
                            font-size: 13px;
                            color: #a4a4b2;
                            horizontal-alignment: center;
                        }
                    }

                    // Progress Bar Container
                    VerticalLayout {
                        spacing: 8px;
                        width: parent.width * 0.85;
                        x: (parent.width - self.width) / 2;

                        Rectangle {
                            height: 8px;
                            border-radius: 4px;
                            background: #181820;
                            border-width: 1px;
                            border-color: #292936;
                            clip: true;

                            Rectangle {
                                x: 0;
                                y: 0;
                                width: parent.width * Math.min(1.0, Math.max(0.02, root.progress));
                                height: parent.height;
                                border-radius: 4px;
                                background: @linear-gradient(90deg, #FF4D00 0%, #FF6A24 70%, #FF9A62 100%);
                                animate width { duration: 150ms; easing: ease-out; }
                            }
                        }

                        HorizontalLayout {
                            Text {
                                text: "Aguarde a extração e registro dos componentes...";
                                font-size: 11px;
                                color: #6e6e7c;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: Math.round(root.progress * 100) + "%";
                                font-size: 11px;
                                font-weight: 600;
                                color: #FF9A62;
                            }
                        }
                    }
                }

                // ── STEP 2: Completed ────────────────────────────────────
                if root.step == 2: VerticalLayout {
                    spacing: 24px;
                    alignment: center;

                    // Success icon
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        x: (parent.width - self.width) / 2;
                        border-radius: 32px;
                        background: @linear-gradient(135deg, #FF4D0022 0%, #FF6A2444 100%);
                        border-width: 2px;
                        border-color: #FF6A24;

                        Path {
                            width: 100%;
                            height: 100%;
                            commands: "M 6 12 L 10 16 L 18 8";
                            stroke: #FF9A62;
                            stroke-width: 3px;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 24;
                            viewbox-height: 24;
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "Instalação Concluída!";
                            font-size: 22px;
                            font-weight: 700;
                            color: #f6f6f8;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "O NXYVEN v1.0.0 foi instalado e registrado com sucesso.";
                            font-size: 13px;
                            color: #9292a0;
                            horizontal-alignment: center;
                        }
                    }

                    // Completed Actions
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: center;

                        finish-btn := Rectangle {
                            width: 120px;
                            height: 40px;
                            border-radius: 6px;
                            background: finish-touch.has-hover ? #22222c : #181820;
                            border-width: 1px;
                            border-color: #323242;

                            Text {
                                text: "Concluir";
                                font-size: 13px;
                                font-weight: 600;
                                color: #d4d4dc;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            finish-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close-window(); }
                            }
                        }

                        launch-btn := Rectangle {
                            width: 170px;
                            height: 40px;
                            border-radius: 6px;
                            background: launch-touch.has-hover
                                ? @linear-gradient(135deg, #FF5E1A 0%, #FF7B3D 50%, #FFA875 100%)
                                : @linear-gradient(135deg, #FF4D00 0%, #FF6A24 50%, #FF9A62 100%);
                            animate background { duration: 140ms; }

                            Text {
                                text: "Iniciar NXYVEN";
                                font-size: 13px;
                                font-weight: 700;
                                color: #ffffff;
                                letter-spacing: 0.5px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            launch-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.launch-app(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
